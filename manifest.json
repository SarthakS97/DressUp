{
  "manifest_version": 3,
  "name": "DressUp — Try It On Anything",
  "version": "0.1.0",
  "description": "Right-click any outfit pic on the internet and see it on YOU. Powered by YouCam AI.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "contextMenus",
    "storage"
  ],
  "host_permissions": [
    "https://yce-api-01.makeupar.com/*",
    "<all_urls>"
  ]
}
